# Wormhole — API keys
# Copy this file to .env and fill in the keys for providers you want to use.
# All of the providers below have a FREE tier — no credit card needed.
# .env is never committed, and keys are never shown in the dashboard.

# ── Free tier providers ──────────────────────────────────────────────
# Groq — free 30 req/min, very fast. Get key: https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — ~1M tokens/day free. Get key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Google AI Studio (Gemini) — generous free tier. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Mistral — ~1B tokens/month free (phone verification). https://console.mistral.ai
MISTRAL_API_KEY=

# OpenRouter — rotating free models (:free suffix). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# NVIDIA NIM — 40 req/min free. Get key: https://build.nvidia.com
NVIDIA_API_KEY=

# SambaNova — free 20 req/min. https://cloud.sambanova.ai
# SAMBANOVA_API_KEY=

# Hugging Face router — small monthly free credit. https://hf.co/settings/tokens
# HF_TOKEN=

# ── Paid / other (optional) ──────────────────────────────────────────
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# XAI_API_KEY=
# COHERE_API_KEY=
